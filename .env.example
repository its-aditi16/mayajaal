# Copy to .env. Everything is optional: with nothing set, Mayajaal runs fully offline using
# Ollama if available, local fallbacks, and an in-process verification copy.

# --- Memory (Hindsight) ---
# auto = use Hindsight if reachable, otherwise the local fallback. hindsight = warn loudly if it is down.
MAYAJAAL_MEMORY_BACKEND=auto
MAYAJAAL_HINDSIGHT_URL=http://localhost:8888
MAYAJAAL_HINDSIGHT_API_KEY=
# chunks = no LLM on retain, works on a laptop. concise = LLM fact extraction, needs a fast cloud model.
MAYAJAAL_HINDSIGHT_EXTRACTION_MODE=chunks

# --- Defender AI ---
# auto = Foundry if configured, then Groq, then Ollama, otherwise built-in templates.
MAYAJAAL_LLM_PROVIDER=auto
# Fast, with a free tier. Get a key at console.groq.com/keys
MAYAJAAL_GROQ_API_KEY=
MAYAJAAL_GROQ_MODEL=openai/gpt-oss-120b
# OpenAI-compatible Foundry endpoint, ending in /openai/v1
MAYAJAAL_FOUNDRY_ENDPOINT=
MAYAJAAL_FOUNDRY_API_KEY=
# Your deployment name
MAYAJAAL_FOUNDRY_MODEL=
MAYAJAAL_OLLAMA_URL=http://localhost:11434
MAYAJAAL_OLLAMA_MODEL=qwen2.5:3b

# --- Azure AI Content Safety (Prompt Shields) ---
MAYAJAAL_CONTENT_SAFETY_ENDPOINT=
MAYAJAAL_CONTENT_SAFETY_KEY=

# --- Alerts ---
# Teams Workflows webhook. Without it, cards go to alerts_outbox.jsonl in the data folder.
MAYAJAAL_TEAMS_WEBHOOK_URL=
# Address approvers use to reach the worker, for links on Teams cards
MAYAJAAL_PUBLIC_BASE_URL=http://127.0.0.1:8100
# Microsoft Sentinel, through the Logs Ingestion API
MAYAJAAL_SENTINEL_TENANT_ID=
MAYAJAAL_SENTINEL_CLIENT_ID=
MAYAJAAL_SENTINEL_CLIENT_SECRET=
MAYAJAAL_SENTINEL_DCE_ENDPOINT=
MAYAJAAL_SENTINEL_DCR_ID=
MAYAJAAL_SENTINEL_STREAM=Custom-Mayajaal_CL

# --- Event bus ---
# Empty = durable SQLite outbox.
MAYAJAAL_REDIS_URL=

# --- Verification copy ---
# auto = Docker if the mayajaal:latest image exists, otherwise an in-process copy.
MAYAJAAL_SANDBOX_BACKEND=auto

# --- Timing and privacy ---
MAYAJAAL_SHADOW_SECONDS=600
MAYAJAAL_SHADOW_SECONDS_PROVEN=60
MAYAJAAL_RETENTION_DAYS=30

# --- Hindsight's own model (used by docker-compose) ---
# Local and free, but too slow for reflect on a laptop CPU:
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_API_LLM_MODEL=qwen2.5:3b
HINDSIGHT_API_LLM_API_KEY=
# Fast, with a free tier. Get a key at console.groq.com/keys:
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_BASE_URL=https://api.groq.com/openai/v1
# HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
# HINDSIGHT_API_LLM_API_KEY=your-key
